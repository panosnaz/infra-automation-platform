# Copy this file to .env and replace every CHANGE-ME value.
# This stack is independent from the existing Nautobot project.

NAUTOBOT_SECRET_KEY=CHANGE-ME-generate-a-long-random-secret
NAUTOBOT_ALLOWED_HOSTS=localhost 127.0.0.1
NAUTOBOT_DEBUG=False

NAUTOBOT_DB_HOST=isolated-postgres
NAUTOBOT_DB_PORT=5432
NAUTOBOT_DB_NAME=nautobot_isolated
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=CHANGE-ME-db-password
NAUTOBOT_DB_TIMEOUT=60
NAUTOBOT_DB_ENGINE=django.db.backends.postgresql

NAUTOBOT_REDIS_HOST=isolated-redis
NAUTOBOT_REDIS_PORT=6379
NAUTOBOT_REDIS_PASSWORD=CHANGE-ME-redis-password

NAUTOBOT_CREATE_SUPERUSER=true
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin-isolated@example.com
NAUTOBOT_SUPERUSER_PASSWORD=CHANGE-ME-admin-password
NAUTOBOT_SUPERUSER_API_TOKEN=CHANGE-ME-40-character-api-token

# Optional legacy ACI SSoT environment settings.
# Newer nautobot-ssot versions can use Controller and ExternalIntegration objects.
NAUTOBOT_APIC_BASE_URI_LAB=https://172.30.46.103/
NAUTOBOT_APIC_USERNAME_LAB=admin
NAUTOBOT_APIC_PASSWORD_LAB=CHANGE-ME-apic-password
NAUTOBOT_APIC_VERIFY_LAB=False
NAUTOBOT_APIC_SITE_LAB=Isolated Lab Site
NAUTOBOT_APIC_TENANT_PREFIX_LAB=ISOLATED
