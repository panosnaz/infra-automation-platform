# PREFERRED: Load credentials from Vault instead of a static tfvars file.
#   export VAULT_ADDR=http://localhost:8200
#   export VAULT_TOKEN=<token>
#   source scripts/load-vault-creds.sh
#   terraform plan
#
# This file is a fallback for environments without Vault access. Copy it to
# terraform.tfvars and fill in your values. Never commit terraform.tfvars —
# it is gitignored.

aci_url             = "https://172.30.46.103"
aci_username        = "admin"
aci_password        = "CHANGE_ME"
aci_insecure        = true   # required for self-signed ACI Simulator certificate

# Path to the NetAsCode YAML generated by platform/python/generate_aci.py
# Default is correct when running from platform/terraform/aci/
netascode_yaml_file = "../../netascode/aci/tenants.yaml"
