#!/usr/bin/env expect -f
# cml-jump-relay.exp — run a single non-interactive shell command on a CML
# lab's jump host via CML's SSH console-proxy ("open /<lab>/<node>/0"),
# capturing just that command's stdout and exit code.
#
# Why this exists: the CML lab's simulated devices (172.30.46.220-223 for
# the VXLAN-EVPN-MultiSite lab) are only reachable from inside CML's own
# network -- neither this repo's dev host nor the gitlab-runner container
# has a route to them (Bridge-mode external connectivity from outside CML
# is broken, root cause unresolved -- ADR-021 SS5/SS12). The jump host
# (an alpine node inside the lab) does have that route. This script lets a
# CI job (which can reach the CML controller directly) relay individual
# commands to the jump host instead, without needing its own network path
# to the lab's OOB segment.
#
# The console-proxy is a raw serial-console session (not a normal SSH exec
# channel), so ordinary `ssh host "command"` piping doesn't work -- this
# script drives it the same way an interactive operator would: connect,
# send a wake-up keypress, log in if a fresh boot demands it, then send the
# command wrapped in unique markers and wait for them to delimit the real
# output from console noise/echo. (An earlier version of this script
# assumed the console was always responsive immediately after the
# "Connected to CML terminalserver." banner with no wake-up or login step
# needed -- true for a console still mid-session from an earlier
# connection, confirmed false for a freshly-booted node: 2026-08-26 testing
# against a cold-booted jump host showed it stays silent until sent a bare
# `\r`, and may then show either a shell prompt or an OS "login:" prompt.)
#
# Usage:
#   expect cml-jump-relay.exp <cml_host> <cml_user> <cml_password> \
#       <lab_name> <node_label> <command> <timeout_seconds> [jh_user] [jh_pass]
#
# jh_user/jh_pass (default cisco/cisco, confirmed from the alpine node's
# day-0 config in knowledge/runbooks/CML-EVPN-Lab-Jump-Host.md SS4, not
# guessed) log into the jump host's OS console after a cold boot -- a
# freshly-started node sits at a "login:" prompt, not a shell prompt, and
# earlier versions of this script assumed the latter unconditionally.
#
# Exit code: the relayed command's own exit code (0-255), or 124 on
# expect-level timeout/failure (never confused with a real command's exit
# code, which CML/alpine's ash never exceeds). Connection establishment has
# observed real intermittent flakiness (roughly 1 in 3 attempts in testing)
# -- callers should retry on exit 124, see cml-jump-relay.sh.

set cml_host    [lindex $argv 0]
set cml_user    [lindex $argv 1]
set cml_pass    [lindex $argv 2]
set lab_name    [lindex $argv 3]
set node_label  [lindex $argv 4]
set command     [lindex $argv 5]
set cmd_timeout [lindex $argv 6]
set jh_user     [expr {[llength $argv] > 7 ? [lindex $argv 7] : "cisco"}]
set jh_pass     [expr {[llength $argv] > 8 ? [lindex $argv 8] : "cisco"}]

set timeout $cmd_timeout
log_user 0

set marker_start "___RELAY_START_[pid]___"
set marker_end   "___RELAY_END_[pid]___EXIT_"

spawn sshpass -p $cml_pass ssh -tt -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $cml_user@$cml_host "open /$lab_name/$node_label/0"

expect {
    "Connected to CML terminalserver." {
    }
    timeout {
        puts stderr "RELAY-ERROR: timed out waiting for console connection"
        exit 124
    }
}

# A wake-up keypress is required before the console produces anything at
# all -- confirmed live (2026-08-26): a cold-booted jump host stays
# completely silent after "Connected to CML terminalserver." until sent one,
# contradicting an earlier version of this script's assumption that no
# wake-up phase was needed (that assumption held for a console already
# mid-session from a previous connection, not a fresh boot).
send "\r"

# A freshly-booted jump host then shows an OS "login:" prompt; a
# still-running one from an earlier session goes straight to its shell
# prompt (possibly preceded by escape-sequence noise, e.g. a cursor-position
# query some shells emit while drawing their prompt -- harmless to ignore,
# since the marker-based command below tolerates arbitrary leading noise and
# doesn't depend on matching the prompt text itself). A short, dedicated
# timeout here distinguishes "no login prompt showed up" from a hang.
set full_timeout $cmd_timeout
set timeout 5
expect {
    -re {(?i)login:\s*$} {
        send "$jh_user\r"
        set timeout 10
        expect {
            -re {(?i)assword:\s*$} {
                send "$jh_pass\r"
            }
            timeout {
                puts stderr "RELAY-ERROR: timed out waiting for jump-host password prompt"
                exit 124
            }
        }
    }
    timeout {
        # no login prompt within 5s -- already at a shell prompt
    }
}
set timeout $full_timeout

# A previous attempt (this script or cml-jump-fetch-file.exp) that timed
# out mid-transfer can leave the console stuck inside a stale nested
# `sftp>` sub-session -- the console-proxy reattaches to the same live
# serial session, it doesn't reset remote state. `bye` is harmless either
# way: exits a stray sftp session, or fails as an unknown shell command
# (exit 127) if there wasn't one. See cml-jump-fetch-file.exp for where
# this was first confirmed live (2026-08-26).
send "bye\r"
sleep 1

send "echo ${marker_start}; $command; echo \"${marker_end}\$?\"\r"

# marker_start appears twice in the buffer: once in the console's echo of
# the typed input line, once in the real command output. A naive greedy
# regex anchors on the first (wrong) occurrence, prepending the tail of the
# echoed input line to the captured output. Fixed by capturing broadly then
# slicing from the LAST occurrence of marker_start with `string last`,
# rather than relying on regex greediness to pick the right one.
set pattern "${marker_start}(.*)${marker_end}(\[0-9\]+)"
expect {
    -re $pattern {
        set raw_output $expect_out(1,string)
        set exit_code $expect_out(2,string)
        set last_start [string last $marker_start $raw_output]
        if {$last_start >= 0} {
            set output [string range $raw_output [expr {$last_start + [string length $marker_start]}] end]
        } else {
            set output $raw_output
        }
        puts [string trim $output "\r\n"]
        send "\x1d"
        catch {exp_close}
        catch {wait}
        exit $exit_code
    }
    timeout {
        puts stderr "RELAY-ERROR: timed out waiting for command completion"
        exit 124
    }
}
