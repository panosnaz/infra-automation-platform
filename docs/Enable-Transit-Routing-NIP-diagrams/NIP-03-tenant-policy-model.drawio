0;" edge="1" parent="1" source="c33" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Bridge domain DB_BD&lt;/b&gt; &lt;span style=&#x27;font-size:12px;color:#26282B&#x27;&gt;unicast routing on&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#26282B&#x27;&gt;10.0.2.254/24 · private (PBR lab, unchanged)&lt;br&gt;10.0.3.254/24 · &lt;b&gt;public&lt;/b&gt; (transit, D5)&lt;br&gt;associated L3Out: &lt;b&gt;OSPF_L3Out&lt;/b&gt;&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F9EE;strokeColor=#5A9C3A;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="610" y="560" width="380" height="92" as="geometry"/></mxCell><mxCell id="c36" value=" advertised through " style="fontFamily=Segoe UI;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=15;fontStyle=1;fontColor=#FFFFFF;labelBackgroundColor=#26282B;strokeColor=#26282B;strokeWidth=1.8;endArrow=block;endFill=1;fontSize=11;fontStyle=0;fontColor=#26282B;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="578"/><mxPoint x="1020" y="100"/></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;span style=&#x27;font-size:12.5px;color:#26282B&#x27;&gt;&lt;b&gt;External Subnets for the External EPG&lt;/b&gt; (import-security) classifies traffic for the contract. &lt;b&gt;Export Route Control Subnet&lt;/b&gt; (export-rtctrl) advertises the prefix out of that L3Out. No subnet carries Shared Route Control or Shared Security Import: no other VRF imports these routes. Each /32 is classified by one external EPG only.&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26282B;strokeWidth=2;align=left;verticalAlign=middle;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="50" y="700" width="1540" height="50" as="geometry"/></mxCell><mxCell id="c38" value="&lt;span style=&#x27;font-size:12px;color:#8A8F98&#x27;&gt;Objects of the next labs share this tenant and are not shown: PBR (DB_EPG, Backup_EPG, Backup_BD, FW_Ct, FW_SGT) and VRF route leaking (SharedServices_VRF/BD/EPG, Web_EPG, Presales_BD, WebServices_Ct).&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F98;strokeWidth=2;dashed=1;align=left;verticalAlign=middle;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="1540" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>