yle=&#x27;font-size:12px;color:#555&#x27;&gt;— DB_BD transit subnet, public, associated with OSPF_L3Out&lt;/span&gt;" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="20" y="646" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;DB_BD&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px;color:#26282B&#x27;&gt;10.0.2.254/24 private&lt;br&gt;10.0.3.254/24 public&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F9EE;strokeColor=#5A9C3A;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="740" y="650" width="160" height="64" as="geometry"/></mxCell><mxCell id="c55" value="" style="shape=point;size=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="2" height="2" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=point;size=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1150" y="680" width="2" height="2" as="geometry"/></mxCell><mxCell id="c57" value=" advertised " style="fontFamily=Segoe UI;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=15;fontStyle=1;fontColor=#FFFFFF;labelBackgroundColor=#26282B;strokeColor=#0E9C80;strokeWidth=3;endArrow=block;endFill=1;labelBackgroundColor=#0E9C80;fontSize=12;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="&lt;span style=&#x27;font-size:12px;color:#C0304B&#x27;&gt;&lt;b&gt;✘ Denied&lt;/b&gt; — &lt;b&gt;deny-prefix-out&lt;/b&gt; (D4):&lt;br&gt;the Catalyst never learns 10.0.3.0/24&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF0F2;strokeColor=#C0304B;strokeWidth=2;align=left;verticalAlign=middle;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1160" y="658" width="330" height="46" as="geometry"/></mxCell><mxCell id="c59" value="&lt;span style=&#x27;font-size:12px;color:#C0304B&#x27;&gt;&lt;b&gt;✘ Not advertised&lt;/b&gt; — DB_BD is not&lt;br&gt;associated with BGP_L3Out&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF0F2;strokeColor=#C0304B;strokeWidth=2;align=left;verticalAlign=middle;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="330" y="686" width="300" height="46" as="geometry"/></mxCell><mxCell id="c60" value="&lt;span style=&#x27;font-size:12.5px;color:#26282B&#x27;&gt;&lt;b&gt;Towards the Catalyst:&lt;/b&gt; 172.16.200.200/32 is marked &lt;b&gt;Export Route Control&lt;/b&gt; on Cat_ExtNet and is also permitted by entry 0 (&lt;b&gt;match-permit-prefix-out&lt;/b&gt;) of the route map &lt;b&gt;Uni-Route-Profile-OUT&lt;/b&gt;, bound export on Cat_ExtNet. Entry 1 (&lt;b&gt;deny-prefix-out&lt;/b&gt;) denies 172.16.199.199/32 and 10.0.3.0/24; anything else falls to the map&#x27;s implicit deny.&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFCF3;strokeColor=#D9A23A;strokeWidth=2;align=left;verticalAlign=middle;spacing=8;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1600" height="50" as="geometry"/></mxCell><mxCell id="c61" value="─▶ permitted" style="fontFamily=Segoe UI;rounded=1;arcSize=20;html=1;fillColor=#0E9C80;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="832" width="114" height="26" as="geometry"/></mxCell><mxCell id="c62" value="✕ denied / not advertised" style="fontFamily=Segoe UI;rounded=1;arcSize=20;html=1;fillColor=#C0304B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="832" width="218" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>