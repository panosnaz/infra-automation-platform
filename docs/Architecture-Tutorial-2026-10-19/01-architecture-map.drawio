" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Writes / changes something" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1330" y="67" width="360" height="24" as="geometry"/></mxCell><mxCell id="c23" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1225" y="116" width="1" height="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1315" y="116" width="1" height="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="fontFamily=Segoe UI;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=15;fontStyle=1;fontColor=#FFFFFF;labelBackgroundColor=#26282B;strokeColor=#2875E2;strokeWidth=2;dashed=1;dashPattern=8 5;endArrow=open;endSize=9;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Reads only — never changes anything" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1330" y="105" width="360" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1225" y="154" width="1" height="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="text;" vertex="1" parent="1"><mxGeometry x="1315" y="154" width="1" height="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="fontFamily=Segoe UI;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;fontSize=15;fontStyle=1;fontColor=#FFFFFF;labelBackgroundColor=#26282B;strokeColor=#D9A23A;strokeWidth=3;dashed=1;dashPattern=2 4;endArrow=block;endFill=1;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Event — something is triggered" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1330" y="143" width="360" height="24" as="geometry"/></mxCell><mxCell id="c31" value=" 7 " style="fontFamily=Segoe UI;rounded=1;arcSize=20;html=1;fillColor=#26282B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1225" y="190" width="34" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Numbered chip = one conversation between two components. The table on the next pages names the protocol for each number." style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1270" y="186" width="420" height="40" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Solid box&lt;/b&gt; = a running component &amp;nbsp;·&amp;nbsp; &lt;b&gt;Coloured strip&lt;/b&gt; = a CI job" style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#26282B;" vertex="1" parent="1"><mxGeometry x="1225" y="240" width="460" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Lab values shown (ports, 172.30.46.103). A customer site differs only in those values." style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="1225" y="264" width="460" height="24" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Network engineer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;asks in plain English&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26282B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="240" height="80" as="geometry"/></mxCell><mxCell id="c36" value="" style="shape=mxgraph.networks.users;fillColor=#2875E2;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="47" y="244.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;AI Agent (MCP client)&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;VS Code Copilot · Claude&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;reasons, picks tools, calls them&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E9C80;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="400" width="240" height="110" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker;fillColor=#01A88D;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="47" y="429.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;The agent never touches the network.&lt;/b&gt; Its only hands are the MCP tools. Everything else on this map happens without it." style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0E6E5C;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="230" height="110" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Reasoning layer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;LangGraph · diagnose&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;review-plan · read-only&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A23A;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="35" y="700" width="240" height="110" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;fillColor=#D9A23A;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="47" y="729.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Reads, never writes.&lt;/b&gt; An allowlist lets it call only get_ / list_ / show_ tools, and it holds no password. It explains; a person still approves." style="fontFamily=Segoe UI;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8A6414;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="230" height="130" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Developer workstation&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;edits platform code · runs pytest (1,086 tests)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;never runs in CI today&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B6573;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="360" height="90" as="geometry"/></mxCell><mxCell id="c44" value="" style="shape=mxgraph.networks.laptop;fillColor=#5B6573;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="342" y="74.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;MCP Server :8071&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;138 tools · one Pydantic schema each&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;the EXTERNAL API — agents + reasoning layer&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="360" height="110" as="geometry"/></mxCell><mxCell id="c46" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#E7157B;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="342" y="429.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Nautobot — Source of Truth :8080&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;Tenants, Locations, Devices, VLANs&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;intent stored in 40 aci_* Custom Fields (JSON)&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="360" height="110" as="geometry"/></mxCell><mxCell id="c48" value="" style="shape=mxgraph.networks.storage;fillColor=#7B42BC;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="342" y="629.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;SoT integrity check&lt;/b&gt;&lt;br&gt;bootstrap_nautobot.py --verify&lt;br&gt;(all 40 fields declared?)" style="fontFamily=Segoe UI;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B42BC;dashed=1;fontSize=12;fontColor=#4B2A7A;" vertex="1" parent="1"><mxGeometry x="330" y="730" width="300" height="62" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Nautobot webhook&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;fires on Tenant create / update&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;sent by the Celery worker → GitLab&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=74;spacingRight=6;fontSize=13;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="330" y="830" width="360" height="90" as="geometry"/></mxCell><mxCell id="c51" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;fillColor=#E7157B;strokeColor=#ffffff;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="342" y="849.0" width="52" height="52" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Git repository&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;code + generated YAML&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;history = audit trail&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E24329;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=6;fontSize=12.5;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="750" y="55" width="200" height="90" as="geometry"/></mxCell><mxCell id="c53" value="" style="shape=mxgraph.azure.git_repository;fillColor=#F05033;strokeColor=none;html=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="762" y="78.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;GitLab Runner&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;runs every job in a&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11.5px;color:#555&#x27;&gt;python:3.12 container&lt;/span&gt;" style="fontFamily=Segoe UI;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=6;fontSize=12.5;fontColor=#26282B;shadow=1;" vertex="1" parent="1"><mxGeometry x="965" y="55" width="200" height="90" as="geometry"/></mxCell><mxCell id="c55" value="" styl