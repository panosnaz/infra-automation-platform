# Nested git repo — handle as submodule or separate decision
docker/nautobot/

# Vault unseal keys — never commit
docker/vault/state/*.txt
docker/vault/state/*.json

# Legacy Platform v1 runtime data (execution_store.db, policy_denials.jsonl,
# knowledge/) -- app code archived to archive/platform-v1/, but this
# directory's contents are root-owned leftover container bind-mount data
# that could not be removed without sudo. Never commit it.
docker/platform-api/data/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
.pytest_cache/

# macOS / Zone.Identifier artifacts
*.Zone.Identifier
.DS_Store

# Environment / secrets — never commit
*.env
!*.example.env
!creds.example.env

# Generator output — produced by generate_aci.py, not source
platform/netascode/aci/tenants.yaml

# Terraform variable files with real credentials
terraform.tfvars
*.auto.tfvars
